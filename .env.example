FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:android:abcdef0123456789

# App Configuration
APP_DEFAULT_LOCALE=vi
DEFAULT_SEARCH_RADIUS_KM=3.0
DEFAULT_RESERVATION_DURATION_MINUTES=20
MAX_NO_SHOW_THRESHOLD=3
