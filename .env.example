# Google Maps API Keys
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSyYourAndroidMapsApiKeyHere
GOOGLE_MAPS_API_KEY_IOS=AIzaSyYourIosMapsApiKeyHere

# Firebase Configuration (for web/desktop if needed, Android/iOS usually use google-services.json / GoogleService-Info.plist)
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
